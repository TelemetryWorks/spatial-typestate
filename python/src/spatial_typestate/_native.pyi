from typing import Any, Never

class SpatialError(ValueError):
    code: str
    index: int | None

class Frame:
    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Unit:
    def __new__(cls) -> Never: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

METERS: Unit
FEET: Unit
DIMENSIONLESS: Unit

class Points:
    def __new__(cls) -> Never: ...
    @classmethod
    def from_buffer(cls, buffer: Any, frame: Frame, unit: Unit) -> Points: ...
    @property
    def frame(self) -> Frame: ...
    @property
    def unit(self) -> Unit: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    def __len__(self) -> int: ...
    def view(self) -> memoryview: ...
    def convert_to(self, unit: Unit) -> Points: ...

class Vectors:
    def __new__(cls) -> Never: ...
    @classmethod
    def from_buffer(cls, buffer: Any, frame: Frame, unit: Unit) -> Vectors: ...
    @property
    def frame(self) -> Frame: ...
    @property
    def unit(self) -> Unit: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    def __len__(self) -> int: ...
    def view(self) -> memoryview: ...
    def convert_to(self, unit: Unit) -> Vectors: ...

class Quaternion:
    def __init__(self, frame: Frame, x: float, y: float, z: float, w: float) -> None: ...
    @property
    def frame(self) -> Frame: ...
    @property
    def components(self) -> tuple[float, float, float, float]: ...

class Transform:
    def __new__(cls) -> Never: ...
    @classmethod
    def from_rotation_translation(cls, source: Frame, target: Frame, unit: Unit,
                                  rotation: Quaternion, translation: tuple[float, float, float]) -> Transform: ...
    @classmethod
    def from_matrix(cls, source: Frame, target: Frame, unit: Unit,
                    matrix: Any) -> Transform: ...
    @property
    def source(self) -> Frame: ...
    @property
    def target(self) -> Frame: ...
    @property
    def unit(self) -> Unit: ...
    @property
    def matrix(self) -> list[list[float]]: ...
    def apply_points(self, points: Points) -> Points: ...
    def apply_vectors(self, vectors: Vectors) -> Vectors: ...
    def then(self, next: Transform) -> Transform: ...
    def inverse(self) -> Transform: ...
    def convert_to(self, unit: Unit) -> Transform: ...
